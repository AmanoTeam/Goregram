git clone https://github.com/tdlib/td
cd td/example/android
# copy build-tdlib.sh and CMakeLists.txt into this folder
./fetch-sdk.sh
# copy libressl from TMessagesProj/jni/libressl into td/example/android/third-party/openssl with such structure:
# third-party/
#   openssl/
#     $ARCH/
#       include/ <- TMessagesProj/jni/libressl/include
#       lib/ <- TMessagesProj/jni/libressl/lib/$ARCH
./build-tdlib.sh
# gather libtde2e.a and libtdutils.a into TMessagesProj/jni/tde2e/$ARCH